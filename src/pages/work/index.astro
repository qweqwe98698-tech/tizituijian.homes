---
/*
  The full shelf. Same rows as the home band, in the same order, with the
  archived products dropped to a group of their own at the foot -- a shelf and
  a storeroom, not two kinds of card.
*/
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import WorkList from '../../components/WorkList.astro';
import { getWork } from '../../lib/content';
import { useT } from '../../i18n/t';

const all = await getWork();
const shelf = all.filter((w) => w.data.status !== 'archived');
const archived = all.filter((w) => w.data.status === 'archived');

const t = useT(Astro.currentLocale);
const description = t.workDescription;

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: t.work },
    ],
  },
  {
    '@type': 'CollectionPage',
    name: `${t.work} · 梯子推荐`,
    description,
    url: new URL('/work/', Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: shelf.map((w, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(`/work/${w.id}/`, Astro.site).href,
        name: w.data.title,
      })),
    },
  },
];
---

<Base title={t.work} description={description} {jsonLd}>
  <PageHead title={t.work} lead={description} />

  {shelf.length > 0 && (
    <section class="border-border border-t">
      <div class="mx-auto max-w-wide px-4 py-12 md:py-16">
        <WorkList items={shelf} class="text-2xl md:text-4xl" />
      </div>
    </section>
  )}

  {archived.length > 0 && (
    <section class="border-border border-t">
      <div class="mx-auto max-w-wide px-4 py-10 md:py-14">
        <h2 class="text-muted font-mono text-sm">{t.archived}</h2>
        <WorkList items={archived} class="mt-5 text-xl md:text-2xl" />
      </div>
    </section>
  )}
</Base>
