---
/*
  Airport Brand Detail & Evaluation Page.
  Preserves Leader's signature table-of-contents layout and typography.
*/
import { render } from 'astro:content';
import katexCss from 'katex/dist/katex.min.css?url';
import Base from '../../layouts/Base.astro';
import LeaderRow from '../../components/LeaderRow.astro';
import NoteList from '../../components/NoteList.astro';
import {
  categoryOf,
  categoryPath,
  getNotes,
  getWork,
  neighbours,
  workPath,
  year,
} from '../../lib/content';
import { fmt, useT } from '../../i18n/t';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const category = categoryOf(data.category);
const t = useT(Astro.currentLocale);
const { Content, remarkPluginFrontmatter } = await render(entry);

const shelf = await getWork();
const { next } = neighbours(shelf, entry.id);
const following = next ?? shelf[0];

// Metadata under the heading
const meta = [
  { label: t.status[data.status] },
  { label: fmt(t.since, { year: year(data.started) }) },
  data.coupon && { label: `优惠码: ${data.coupon}` },
  data.hasSpeedtest && { label: '已验证节点测速' },
  data.affiliateUrl && {
    label: '直达官网 ↗',
    href: data.affiliateUrl,
    target: '_blank',
    rel: 'nofollow sponsored noopener',
  },
].filter(Boolean) as { label: string; href?: string; target?: string; rel?: string }[];

const notes = (await getNotes()).filter((n) => n.data.work?.id === entry.id);

// Extract baseline starting price for Product AggregateOffer schema
const priceMatch = data.summary.match(/(\d+(?:\.\d+)?)\s*元/);
const lowPrice = priceMatch ? priceMatch[1] : '15.00';

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.work, item: new URL('/work', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: data.title },
    ],
  },
  {
    '@type': 'Product',
    name: `${data.title} 机场网络代理服务`,
    description: data.summary,
    brand: { '@type': 'Brand', name: data.title },
    category: category.name,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'CNY',
      lowPrice: lowPrice,
      offerCount: '3',
      availability: 'https://schema.org/InStock',
      url: data.affiliateUrl || new URL(`/work/${entry.id}`, Astro.site).href,
    },
  },
];
---

<Base title={data.title} description={data.summary} {jsonLd}>
  {remarkPluginFrontmatter.hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  <section class="mx-auto max-w-wide px-4 pt-10 pb-8 md:pt-14">
    <p class="text-sm">
      <a href="/work" class="text-muted hover:text-foreground">
        ← {t.work}
      </a>
    </p>

    <h1 class="mt-7 text-3xl md:text-5xl">
      <LeaderRow title={data.title} right={category.name} accent={category.accent} />
    </h1>

    <p class="text-muted mt-4 font-mono text-sm">
      {meta.map(({ label, href, target, rel }, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          {href ? (
            <a href={href} target={target} rel={rel} class="hover:text-foreground">
              {label}
            </a>
          ) : (
            label
          )}
        </>
      ))}
    </p>
  </section>

  <section class="border-border border-t">
    <div class="mx-auto max-w-wide px-4 py-12 md:py-16">
      <!-- GEO Answer-First Executive Summary Block -->
      <div class="border-border border p-5 mb-10 bg-surface/40">
        <div class="flex items-start gap-3">
          <span class="font-mono text-xs uppercase px-1.5 py-0.5 border border-border text-muted shrink-0">
            GEO 评测核心结论
          </span>
          <p class="text-sm text-heading leading-relaxed">
            <strong>{data.title}</strong> 属于 <strong>{category.name}</strong> 梯子服务商（始于 {year(data.started)} 年）。核心定位：{data.summary} 实测晚高峰节点高可用抗封锁，全面兼容 Clash Verge Rev、v2rayN、Sing-box 等主流客户端，适合追求稳定出海体验的办公与流媒体用户。
          </p>
        </div>
      </div>

      <div class="prose">
        <Content />
      </div>
      <p class="text-muted mt-10 font-mono text-sm">
        {t.filedUnder}{' '}
        <a href={categoryPath(category.slug)} style={`color: var(--accent-${category.accent})`}>
          {category.name}
        </a>
      </p>
    </div>
  </section>

  {notes.length > 0 && (
    <section class="border-border border-t">
      <div class="mx-auto max-w-wide px-4 py-10 md:py-14">
        <h2 class="text-muted font-mono text-sm">{fmt(t.notesOn, { title: data.title })}</h2>
        <NoteList notes={notes} class="mt-5 text-lg md:text-2xl" />
      </div>
    </section>
  )}

  {following && following.id !== entry.id && (
    <section class="border-border border-t">
      <div class="mx-auto max-w-wide px-4 py-8 text-right">
        <a href={workPath(following.id)} class="text-muted hover:text-foreground text-sm">
          {fmt(t.nextProduct, { title: following.data.title })} →
        </a>
      </div>
    </section>
  )}
</Base>
