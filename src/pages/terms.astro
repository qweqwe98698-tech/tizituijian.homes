---
/*
  Terms of Service & Disclaimer page - fully localized in Chinese.
*/
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { contact, site } from '../config';

const title = '服务条款与免责声明';
const description = `${site.name} 的服务条款、知识产权保护、第三方服务免责声明及使用规范。本站所有测评与技术文章仅供网络技术学习、科研与信息参考。`;

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: title },
    ],
  },
];
---

<Base {title} {description} {jsonLd}>
  <PageHead {title} lead={description} />

  <section class="border-border border-t">
    <div class="mx-auto max-w-wide px-4 py-12 md:py-16 space-y-10">
      <div class="prose max-w-content">
        <h2>一、服务条款的确认与接受</h2>
        <p>
          欢迎访问 <strong>{site.name}</strong>（以下简称“本站”）。当您访问、浏览或使用本站提供的任何页面、工具目录、测评数据及技术文章时，即表示您已阅读、理解并同意接受本服务条款与免责声明的所有内容。
        </p>

        <h2>二、技术研究与信息参考性质声明</h2>
        <p>
          本站所发布的所有网络代理协议分析（如 VLESS、Hysteria2、TUIC、Shadowsocks）、客户端配置教程、节点延迟与带宽实测数据，<strong>仅作为计算机网络技术研究、跨国学术资料查阅、外贸合规办公及技术交流之目的</strong>。
        </p>
        <p>
          使用者在参考本站信息开展任何网络活动时，必须严格遵守所在国家与地区的法律法规，严禁利用相关网络技术从事任何破坏国家安全、侵犯他人合法权益或违反公共秩序的非法活动。
        </p>

        <h2>三、第三方商业服务独立免责声明</h2>
        <p>
          本站收录并展示的 42 家机场品牌及相关服务商均为独立的第三方商业实体，与本站不存在任何股权、隶属或实际控制关系。本站基于以下原则提供测评信息：
        </p>
        <ul>
          <li>
            <strong>时效性与网络动态波动：</strong>所有测速看板、流媒体解锁情况及套餐价格仅代表测试当时的真实网络表现。国际骨干光缆状况、GFW 动态策略及服务商机房调整均可能导致性能发生变化，本站无法且不对任何第三方服务的即时可用性提供担保。
          </li>
          <li>
            <strong>自主交易与月付原则：</strong>用户与第三方服务商之间发生的任何订阅、充值、交易及纠纷，均由用户与服务商依双方协议自行解决。本站强烈建议所有用户<strong>坚决坚持“按月付费”</strong>，将潜在资金风险降至最低。
          </li>
          <li>
            <strong>不可抗力与跑路免责：</strong>对于任何第三方服务商可能发生的线路中断、服务质量降级、被封锁或恶意跑路违约行为，本站虽会在 <a href="/warnings">跑路预警专题</a> 中及时跟进曝光，但不对任何用户的经济损失承担连带法律责任。
          </li>
        </ul>

        <h2>四、知识产权与内容引用规范</h2>
        <p>
          除明确标注来源于公网开源项目或引用的第三方品牌标识外，本站所有原创编写的文章、测评框架、对比图表及排版设计，其知识产权均归属于 {site.name} 所有。
        </p>
        <p>
          任何个人或机构如需在博客、论坛或社群中引用本站内容，必须保留本站出处并附带可正常访问的原始文章超链接；严禁未经书面许可进行整站大规模自动化抓取或恶意洗稿镜像。
        </p>

        <h2>五、条款的更新与修订</h2>
        <p>
          根据网络环境与相关法规的变化，本站保留在不另行单独通知的情况下，随时修改或更新本条款的权利。修改后的条款一旦发布于本站即行生效。如果您对本条款有任何疑问，请联络：
        </p>
        <p class="font-mono text-sm">
          条款咨询与反馈信箱：<a href={`mailto:${contact.email}`} class="text-heading">{contact.email}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
